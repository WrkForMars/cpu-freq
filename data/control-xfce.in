Package: cpu-freq-xfce
Version: @VERSION@
Architecture: @ARCH@
Maintainer: @MAINT@
Installed-Size: @SIZE@
Depends: @SHLIBS@, cpu-freq (= @VERSION@), xfce4-panel
Section: utils
Priority: optional
